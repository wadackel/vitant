{
  "name": "vitant",
  "version": "0.0.0",
  "private": true,
  "description": "Mutation testing for Vitest",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vitant": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:native": "node native/build.ts",
    "prepack": "tsc -p tsconfig.build.json",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:unit": "node node_modules/vitest/vitest.mjs run --project unit",
    "test:smoke": "node node_modules/vitest/vitest.mjs run --project smoke",
    "test:e2e": "node node_modules/vitest/vitest.mjs run --project e2e",
    "check:quick": "pnpm typecheck && pnpm test:unit",
    "test:packed": "node bench/packed.ts",
    "test:truth": "node bench/truth.ts make --root fixtures/basic --jobs 4 && node bench/truth.ts make --root fixtures/basic --jobs 4 --tool=--static && node bench/truth.ts make --root fixtures/stuck && node bench/truth.ts make --root fixtures/clash && node bench/truth.ts make --root fixtures/walk",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "oxc-parser": "0.152.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "5.0.3",
    "vitest3": "npm:vitest@3.2.6",
    "vitest51": "npm:vitest@5.1.0"
  },
  "files": [
    "dist"
  ]
}
