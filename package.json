{
  "name": "vitant",
  "version": "0.0.0",
  "private": true,
  "description": "Mutation testing for Vitest",
  "type": "module",
  "bin": {
    "vitant": "./src/cli.ts"
  },
  "scripts": {
    "build:native": "node native/build.ts",
    "test": "vitest run",
    "test:truth": "node bench/truth.ts make --root fixtures/basic --jobs 4 && node bench/truth.ts make --root fixtures/stuck",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "oxc-parser": "0.152.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "5.0.3"
  }
}
